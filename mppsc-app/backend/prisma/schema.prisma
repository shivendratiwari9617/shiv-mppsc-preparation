generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Unit {
  id         Int      @id @default(autoincrement())
  code       String   @unique
  name       String
  slug       String   @unique
  orderIndex Int
  topics     Topic[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Topic {
  id           Int        @id @default(autoincrement())
  unitId       Int
  unit         Unit       @relation(fields: [unitId], references: [id], onDelete: Cascade)
  title        String
  coverageNote String?
  vyakhya      String?
  sourceFile   String     @unique
  questions    Question[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([unitId])
}

model Question {
  id           Int           @id @default(autoincrement())
  topicId      Int
  topic        Topic         @relation(fields: [topicId], references: [id], onDelete: Cascade)
  orderIndex   Int
  questionText String
  options      Json
  correctIndex Int
  explanation  String?
  priorityTag  String        @default("HIGH")
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  attempts     Attempt[]
  bookmark     Bookmark?
  reviewState  ReviewState?

  @@unique([topicId, orderIndex])
  @@index([priorityTag])
}

model Session {
  id             Int        @id @default(autoincrement())
  mode           String
  unitId         Int?
  topicId        Int?
  priorityFilter String?
  totalQuestions Int        @default(0)
  correctCount   Int        @default(0)
  wrongCount     Int        @default(0)
  skippedCount   Int        @default(0)
  timeLimitSec   Int?
  startedAt      DateTime   @default(now())
  finishedAt     DateTime?
  attempts       Attempt[]
}

model Attempt {
  id            Int      @id @default(autoincrement())
  sessionId     Int
  session       Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  questionId    Int
  question      Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedIndex Int?
  isCorrect     Boolean
  timeTakenMs   Int?
  attemptedAt   DateTime @default(now())

  @@index([sessionId])
  @@index([questionId])
}

model Bookmark {
  id         Int      @id @default(autoincrement())
  questionId Int      @unique
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
}

model ReviewState {
  id            Int       @id @default(autoincrement())
  questionId    Int       @unique
  question      Question  @relation(fields: [questionId], references: [id], onDelete: Cascade)
  box           Int       @default(1)
  lastResult    Boolean?
  lastAttemptAt DateTime?
  nextDueAt     DateTime?
  timesWrong    Int       @default(0)
  timesCorrect  Int       @default(0)
  updatedAt     DateTime  @updatedAt

  @@index([nextDueAt])
  @@index([timesWrong])
}

model DailyStat {
  id                 Int      @id @default(autoincrement())
  date               DateTime @unique @db.Date
  questionsAttempted Int      @default(0)
  correctCount       Int      @default(0)
  wrongCount         Int      @default(0)
  goalMet            Boolean  @default(false)
}

model Setting {
  key   String @id
  value String
}

model ImportLog {
  id                  Int       @id @default(autoincrement())
  startedAt           DateTime  @default(now())
  finishedAt          DateTime?
  status              String    @default("RUNNING")
  unitsFound          Int       @default(0)
  topicsFound         Int       @default(0)
  questionsFound      Int       @default(0)
  notesFound          Int       @default(0)
  checklistItemsFound Int       @default(0)
  prelimsNotesFound   Int       @default(0)
  message             String?
}

// --- MPESB deep-dive study notes (mpesb-syllabus/notes/) ---
// Plain Markdown reading content, separate from the MCQ practice flow above.
// Categories don't map onto the MPPSC Unit model — they follow the MPESB
// missing-topics taxonomy (Hindi, English, Reasoning, Numerical Aptitude, ...).
model NoteCategory {
  id         Int        @id @default(autoincrement())
  code       String     @unique
  name       String
  slug       String     @unique
  orderIndex Int
  files      NoteFile[]
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
}

model NoteFile {
  id         Int          @id @default(autoincrement())
  categoryId Int
  category   NoteCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  title      String
  sourceFile String       @unique
  content    String
  orderIndex Int
  isRead     Boolean      @default(false)
  readAt     DateTime?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@index([categoryId])
}

// --- Full MPPSC syllabus checklist (mppsc-syllabus/prelims/) ---
// Pure topic lists (numbered lines, no explanations) with per-item
// "studied" checkboxes. ChecklistUnit mirrors the official syllabus units
// (and Paper II), independent of the MCQ Unit model above.
model ChecklistUnit {
  id         Int             @id @default(autoincrement())
  code       String          @unique
  name       String
  slug       String          @unique
  orderIndex Int
  files      ChecklistFile[]
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
}

model ChecklistFile {
  id         Int             @id @default(autoincrement())
  unitId     Int
  unit       ChecklistUnit   @relation(fields: [unitId], references: [id], onDelete: Cascade)
  title      String
  groupLabel String?
  sourceFile String          @unique
  orderIndex Int
  items      ChecklistItem[]
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@index([unitId])
}

model ChecklistItem {
  id         Int           @id @default(autoincrement())
  fileId     Int
  file       ChecklistFile @relation(fields: [fileId], references: [id], onDelete: Cascade)
  orderIndex Int
  label      String
  text       String
  heading    String?
  isChecked  Boolean       @default(false)
  checkedAt  DateTime?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@unique([fileId, orderIndex])
  @@index([fileId])
}

// --- Fact-based MPPSC Prelims content notes (mppsc-syllabus/prelims-notes/) ---
// One deep, NCERT-primary-sourced Markdown note per numbered item in the
// corresponding mppsc-syllabus/prelims/ checklist file. Structurally mirrors
// ChecklistUnit -> ChecklistFile -> ChecklistItem (same units, same topic
// files), but each leaf is a full note with its own read-tracking (like
// NoteFile) rather than just a checkbox.
model PrelimsNoteUnit {
  id         Int                @id @default(autoincrement())
  code       String             @unique
  name       String
  slug       String             @unique
  orderIndex Int
  topics     PrelimsNoteTopic[]
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
}

model PrelimsNoteTopic {
  id         Int               @id @default(autoincrement())
  unitId     Int
  unit       PrelimsNoteUnit   @relation(fields: [unitId], references: [id], onDelete: Cascade)
  title      String
  groupLabel String?
  dirPath    String            @unique
  orderIndex Int
  files      PrelimsNoteFile[]
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@index([unitId])
}

model PrelimsNoteFile {
  id         Int              @id @default(autoincrement())
  topicId    Int
  topic      PrelimsNoteTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)
  title      String
  sourceFile String           @unique
  content    String
  orderIndex Int
  isRead     Boolean          @default(false)
  readAt     DateTime?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@index([topicId])
}
